{
  "model": "model.json",
  "selection": "selection.json",
  "training": {
    "objective": "ae_lm",
    "warmup_epochs": 0,
    "multiround_epochs": 3,
    "global_batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "gradient_clip": 1.0,
    "lm_weight": 1.0,
    "seed": 42,
    "save_every": 1000,
    "eval_every": 1000,
    "generation_samples": 8,
    "ae_prompt": "Reconstruct the text stored in memory:\n",
    "lm_prompt": "Continue the text stored in memory:\n",
    "checkpoint_limit": 2,
    "micro_batch_size": 2,
    "micro_batch_encoder_tokens": 4096,
    "micro_batch_decoder_tokens": 8192
  }
}
